  "type": "device",
  "name": "PrusaLink",
  "description": {
    "en": "Follow your Prusa 3D printers locally with PrusaLink: progress, temperatures, alerts.",
    "fr": "Suivez vos imprimantes 3D Prusa en local par PrusaLink : progression, températures, alertes.",
    "de": "Verfolge deine Prusa-3D-Drucker lokal mit PrusaLink: Fortschritt, Temperaturen, Alarme.",
    "es": "Siga sus impresoras 3D Prusa en local con PrusaLink: progreso, temperaturas, alertas."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-prusalink:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-prusalink/main/cover.png",
  "categories": ["appliances"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your Prusa printers",
        "fr": "Connecter vos imprimantes Prusa",
        "de": "Verbinde deine Prusa-Drucker",
        "es": "Conecte sus impresoras Prusa"
      },
      "description": {
        "en": "Enable PrusaLink on the printer (Settings > Network > PrusaLink), then enter its IP address and the password it shows. Works with the MK4, MK4S, MK3.9, MK3.5, Core One, XL and MINI+ (firmware 5 or later), and the MK3S+ with PrusaLink on a Raspberry Pi. Up to three printers. Everything stays on your network.",
        "fr": "Activez PrusaLink sur l'imprimante (Réglages > Réseau > PrusaLink), puis saisissez son adresse IP et le mot de passe qu'elle affiche. Pour les MK4, MK4S, MK3.9, MK3.5, Core One, XL et MINI+ (firmware 5 ou plus), et la MK3S+ avec PrusaLink sur Raspberry Pi. Jusqu'à trois imprimantes. Tout reste sur votre réseau.",
        "de": "Aktiviere PrusaLink am Drucker (Einstellungen > Netzwerk > PrusaLink) und gib dann seine IP-Adresse und das angezeigte Passwort ein. Für MK4, MK4S, MK3.9, MK3.5, Core One, XL und MINI+ (Firmware 5 oder neuer) sowie den MK3S+ mit PrusaLink auf einem Raspberry Pi. Bis zu drei Drucker. Alles bleibt in deinem Netzwerk.",
        "es": "Active PrusaLink en la impresora (Ajustes > Red > PrusaLink) e introduzca su dirección IP y la contraseña que muestra. Para MK4, MK4S, MK3.9, MK3.5, Core One, XL y MINI+ (firmware 5 o posterior), y la MK3S+ con PrusaLink en una Raspberry Pi. Hasta tres impresoras. Todo se queda en su red."
      },
      "links": [
        {
          "url": "https://help.prusa3d.com/article/prusa-connect-and-prusalink-explained_302608",
          "label": {
            "en": "PrusaLink, by Prusa Research",
            "fr": "PrusaLink, par Prusa Research",
            "de": "PrusaLink von Prusa Research",
            "es": "PrusaLink, de Prusa Research"
          }
        }
      ]
    },
    {
      "key": "url_1",
      "type": "string",
      "label": {
        "en": "Printer address",
        "fr": "Adresse de l'imprimante",
        "de": "Druckeradresse",
        "es": "Dirección de la impresora"
      },
      "placeholder": {
        "en": "e.g. 192.168.1.60",
        "fr": "ex. 192.168.1.60",
        "de": "z. B. 192.168.1.60",
        "es": "p. ej. 192.168.1.60"
      },
      "required": true,
      "default": "",
      "description": {
        "en": "The IP address shown on the printer (Settings > Network). A port is allowed (192.168.1.60:8080).",
        "fr": "L'adresse IP affichée par l'imprimante (Réglages > Réseau). Un port est accepté (192.168.1.60:8080).",
        "de": "Die IP-Adresse, die der Drucker anzeigt (Einstellungen > Netzwerk). Ein Port ist möglich (192.168.1.60:8080).",
        "es": "La dirección IP que muestra la impresora (Ajustes > Red). Se admite un puerto (192.168.1.60:8080)."
      }
    },
    {
      "key": "username_1",
      "type": "string",
      "label": {
        "en": "User",
        "fr": "Utilisateur",
        "de": "Benutzer",
        "es": "Usuario"
      },
      "placeholder": {
        "en": "maker",
        "fr": "maker",
        "de": "maker",
        "es": "maker"
      },
      "required": false,
      "default": "",
      "description": {
        "en": "Leave empty for maker, the user of every printer with PrusaLink built in.",
        "fr": "Laissez vide pour maker, l'utilisateur de toute imprimante à PrusaLink intégré.",
        "de": "Leer lassen für maker, den Benutzer jedes Druckers mit eingebautem PrusaLink.",
        "es": "Déjelo vacío para maker, el usuario de toda impresora con PrusaLink integrado."
